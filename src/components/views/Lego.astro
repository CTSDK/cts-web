---
// LEGO-afdelingen: temaer som runde ikoner (opbygning som på LEGO.com), i CTS-stil.
// Et tema med et sæt kan klikkes; de andre er nedtonede, til der kommer sæt i dem.
import Base from '../../layouts/Base.astro';
import { t, href, asset, type Lang } from '../../i18n/ui';
import { themes } from '../../data/lego';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<Base lang={lang} slug="lego" title={t(lang, 'lego.title')} description={t(lang, 'lego.lead')}>
  <section class="wrap page">
    <div class="issue">
      <span>CTS · No. 01</span>
      <span>LEGO®</span>
    </div>

    <h1>LEGO<span class="r">®</span><span class="dot">.</span></h1>
    <p class="lead">{t(lang, 'lego.lead')}</p>

    <div class="panel">
      <h2 class="panel-title">{t(lang, 'lego.themes')}</h2>
      <ul class="themes">
        {themes.map((th) => th.set ? (
          <li>
            <a class="theme on" href={href(lang, `lego/${th.set}`)} style={`--c: ${th.color}`}>
              <span class="circle">{th.photo ? <img class="ph" src={asset(th.photo)} alt="" width="480" height="480" /> : <span class="mono">{th.mono}</span>}<span class="tag">{t(lang, 'lego.new')}</span></span>
              <span class="name">{th.name[lang]}</span>
            </a>
          </li>
        ) : (
          <li>
            <span class="theme off" style={`--c: ${th.color}`}>
              <span class="circle"><span class="mono">{th.mono}</span><span class="tag soon">{t(lang, 'soon')}</span></span>
              <span class="name">{th.name[lang]}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .page { padding-top: 1.6rem; }
  .issue {
    display: flex; justify-content: space-between; gap: 12px;
    font-family: var(--font-label); text-transform: uppercase; letter-spacing: 0.3em; font-size: 0.78rem; color: var(--ink-soft);
    border-bottom: 1px solid var(--ink); padding-bottom: 0.6rem;
  }
  h1 { font-family: var(--font-serif); font-weight: 700; text-transform: none; color: var(--navy); font-size: clamp(3.4rem, 9vw, 6rem); margin: 2.4rem 0 0.6rem; text-align: center; letter-spacing: 0.04em; }
  .r { font-size: 0.4em; vertical-align: super; }
  .dot { color: var(--orange); }
  .lead { text-align: center; font-size: 1.3rem; line-height: 1.6; color: var(--ink); max-width: 44rem; }

  /* Grå boks med temaer – som på LEGO.com */
  .panel { margin: 3rem auto 0; max-width: 980px; background: #f1eee7; border-radius: 16px; padding: 26px 28px 30px; }
  .panel-title { font-family: var(--font-label); font-weight: 500; text-transform: uppercase; letter-spacing: 0.18em; font-size: 1.05rem; margin: 0 0 1.4rem; }
  .themes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 28px 12px; }
  .theme { display: flex; flex-direction: column; align-items: center; text-decoration: none; color: var(--ink); text-align: center; }
  .circle {
    position: relative; width: 96px; height: 96px; border-radius: 50%; background: var(--c);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 0 4px #f1eee7, 0 0 0 5px var(--ink);
    transition: transform 0.15s ease;
  }
  .ph { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
  .mono { font-family: var(--font-display); font-size: 2rem; color: #fff; letter-spacing: 0.04em; }
  .tag {
    position: absolute; bottom: -10px; left: 50%; transform: translateX(-50%); white-space: nowrap;
    background: var(--mustard); color: var(--ink); font-family: var(--font-label); font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.7rem; padding: 2px 8px; border-radius: 3px;
  }
  .tag.soon { background: #d9d4c8; color: var(--ink-soft); }
  .name { margin-top: 18px; font-family: var(--font-label); font-size: 1rem; letter-spacing: 0.04em; }
  .on:hover .circle { transform: translateY(-3px); }
  .on:hover .name { color: var(--orange); }
  .off { opacity: 0.45; cursor: default; }

  @media (max-width: 820px) { .themes { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 520px) {
    .themes { grid-template-columns: repeat(3, 1fr); }
    .circle { width: 78px; height: 78px; }
    .mono { font-size: 1.6rem; }
    .panel { padding: 20px 14px 24px; }
    .issue { font-size: 0.66rem; letter-spacing: 0.16em; }
  }
</style>
