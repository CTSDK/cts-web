---
// Forsiden som et magasin-cover (opbygning fra rejsemagasinet, stil fra Stone Groove).
import Base from '../../layouts/Base.astro';
import Doors from '../Doors.astro';
import { t, type Lang, asset } from '../../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const year = new Date().getFullYear();
---
<Base lang={lang}>
  <section class="wrap cover">
    <div class="issue">
      <span>{t(lang, 'hero.label')}</span>
      <span class="line" aria-hidden="true"></span>
      <span>{t(lang, 'cover.issue')} · {year}</span>
    </div>

    <div class="grid">
      <div class="text">
        <h1>
          <span class="l1">{t(lang, 'hero.line1')}</span>
          <span class="l2">{t(lang, 'hero.line2')}</span>
        </h1>
        <p class="strap"><span>{t(lang, 'hero.sub')}</span></p>
        <p class="intro">{t(lang, 'home.intro')}</p>
        <a class="btn" href="#departments">{t(lang, 'hero.cta')} ↓</a>
      </div>

      <!-- Coverbillede: seglet indtil videre – her kommer Thomas' foto senere -->
      <figure class="photo">
        <div class="stripes" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        <img class="seal" src={asset('logo-segl.png')} alt="CTS – Copenhagen Treasures & Services, Denmark" width="600" height="600" />
        <figcaption>{t(lang, 'cover.caption')}</figcaption>
      </figure>
    </div>
  </section>

  <section id="departments" class="wrap departments">
    <div class="issue">
      <span>{t(lang, 'cover.inside')}</span>
      <span class="line" aria-hidden="true"></span>
      <span>01 – 03</span>
    </div>
    <h2>{t(lang, 'home.choose')}</h2>
    <Doors lang={lang} />
  </section>
</Base>

<style>
  /* Magasinets tynde "trykte" linje med versaler */
  .issue {
    display: flex; align-items: center; gap: 18px;
    font-family: var(--font-label); text-transform: uppercase; letter-spacing: 0.3em; font-size: 0.85rem;
    border-bottom: 3px double var(--ink); padding: 1.6rem 0 0.7rem;
  }
  .issue .line { flex: 1; border-top: 1.5px solid var(--ink); }

  .grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 48px; padding: 2.6rem 0 3rem; align-items: center; }
  h1 { margin: 0 0 1.4rem; font-size: clamp(2.8rem, 7vw, 6rem); }
  :global(html[lang='de']) h1 { font-size: clamp(2.3rem, 5.4vw, 4.8rem); }
  h1 span { display: block; }
  .l2 { color: var(--orange); }

  /* Strap-line mellem to streger, som på magasinforsiden */
  .strap { border-top: 1.5px solid var(--ink); border-bottom: 1.5px solid var(--ink); padding: 0.55rem 0; margin: 0 0 1.2rem; }
  .strap span { font-family: var(--font-label); font-weight: 500; text-transform: uppercase; letter-spacing: 0.12em; font-size: 1rem; }
  .intro { color: var(--ink-soft); max-width: 34rem; margin: 0 0 1.6rem; }

  /* Coverbilledet */
  .photo {
    position: relative; margin: 0; aspect-ratio: 4 / 5; background: var(--navy);
    display: flex; align-items: center; justify-content: center; overflow: hidden;
    box-shadow: 10px 10px 0 var(--ink);
  }
  .stripes { position: absolute; top: 0; bottom: 0; right: 0; width: 22%; display: grid; grid-template-columns: repeat(4, 1fr); }
  .stripes span:nth-child(1) { background: var(--blue); }
  .stripes span:nth-child(2) { background: var(--mustard); }
  .stripes span:nth-child(3) { background: var(--red); }
  .stripes span:nth-child(4) { background: var(--orange); }
  .seal {
    position: relative; width: 62%; margin-right: 18%; border-radius: 50%;
    background: var(--paper); padding: 4%; box-sizing: content-box; border: 3px solid var(--mustard);
  }
  figcaption {
    position: absolute; left: 0; bottom: 0; right: 22%;
    background: var(--paper); color: var(--ink); padding: 12px 18px;
    font-family: var(--font-label); text-transform: uppercase; letter-spacing: 0.2em; font-size: 0.78rem;
    border-top: 5px solid var(--orange);
  }

  .departments { padding-top: 2rem; }
  .departments h2 { margin-top: 1.6rem; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; gap: 36px; padding-top: 1.8rem; }
    .photo { aspect-ratio: 1 / 1; box-shadow: 6px 6px 0 var(--ink); margin-right: 6px; padding-bottom: 14%; }
    .seal { width: 50%; }
    .issue { letter-spacing: 0.2em; font-size: 0.75rem; gap: 10px; }
  }
</style>
