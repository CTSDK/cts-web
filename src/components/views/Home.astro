---
// Forsiden: samme opbygning som den første side (segl, velkomst, tre døre).
// Stil: magasin-cover (hvidt, serif-overskrift, issue-linje, strap med skråstreg)
// + Stone Groove (marineblå, farvestriber, smalle versaler, skrivemaskine)
// + LEGO-siden (billedvindue med rund "+"-knap i hver dør).
import Base from '../../layouts/Base.astro';
import Doors from '../Doors.astro';
import { t, type Lang, asset } from '../../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const year = new Date().getFullYear();
---
<Base lang={lang}>
  <section class="wrap hero">
    <div class="issue">
      <span>{t(lang, 'issue.left')}</span>
      <span>{t(lang, 'issue.right')} · {year}</span>
    </div>

    <img class="seal" src={asset('logo-segl.png')} alt="" width="200" height="200" />

    <h1>
      <span class="pre">{t(lang, 'home.pre')}</span>
      <span class="big"><span class="spaced">CTS</span><span class="dot">.</span></span>
    </h1>

    <div class="bars" aria-hidden="true"><span></span><span></span><span></span><span></span></div>

    <Doors lang={lang} />

    <div class="about">
      <div class="strap">
        <span>{t(lang, 'strap.left')}</span>
        <span class="slash" aria-hidden="true"></span>
        <span>N°01</span>
      </div>

      <p class="lead">{t(lang, 'home.intro')}</p>
    </div>
  </section>
</Base>

<style>
  .hero { text-align: center; padding-top: 1.6rem; }

  /* Magasinets tynde issue-linje */
  .issue {
    display: flex; justify-content: space-between; gap: 12px;
    font-family: var(--font-label); text-transform: uppercase; letter-spacing: 0.3em; font-size: 0.78rem; color: var(--ink-soft);
    border-bottom: 1px solid var(--ink); padding-bottom: 0.6rem;
  }

  .seal { width: 320px; height: 320px; margin: 2.4rem auto 0.8rem; mix-blend-mode: multiply; }

  /* Overskrift som på magasin-coveret: lille kursiv + stor serif med punktum */
  h1 { text-transform: none; line-height: 1; margin: 0; }
  .pre { display: block; font-family: var(--font-serif); font-style: italic; font-weight: 400; font-size: clamp(1.6rem, 3.4vw, 2.6rem); color: var(--ink-soft); }
  .big { display: block; font-family: var(--font-serif); font-weight: 700; font-size: clamp(3.6rem, 9vw, 6rem); color: var(--navy); line-height: 0.95; }
  .spaced { letter-spacing: 0.22em; }
  .dot { color: var(--orange); margin-left: -0.2em; }

  /* Strap mellem to streger med skråstreg (magasin) */
  .strap {
    display: flex; align-items: stretch; justify-content: center; max-width: 620px; margin: 0 auto 1.8rem;
    border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink);
    font-family: var(--font-label); font-weight: 500; text-transform: uppercase; letter-spacing: 0.18em; font-size: 0.85rem;
  }
  .strap span { padding: 0.6rem 1.2rem; }
  .strap span:first-child { flex: 1; }
  .strap .slash { padding: 0; width: 28px; background: linear-gradient(to top right, transparent calc(50% - 0.6px), var(--ink) calc(50% - 0.6px), var(--ink) calc(50% + 0.6px), transparent calc(50% + 0.6px)); }

  .about { margin-top: 4rem; }
  .lead { font-size: 1.05rem; line-height: 1.8; max-width: 36rem; }

  .bars { display: flex; justify-content: center; gap: 6px; margin: 2.2rem 0 1.4rem; }
  .bars span { width: 34px; height: 6px; }
  .bars span:nth-child(1) { background: var(--blue); }
  .bars span:nth-child(2) { background: var(--mustard); }
  .bars span:nth-child(3) { background: var(--red); }
  .bars span:nth-child(4) { background: var(--orange); }


  @media (max-width: 560px) {
    .issue { font-size: 0.66rem; letter-spacing: 0.16em; }
    .seal { width: 240px; height: 240px; margin-top: 1.8rem; }
    .strap { font-size: 0.72rem; letter-spacing: 0.1em; }
    .strap span { padding: 0.55rem 0.7rem; }
  }
</style>
