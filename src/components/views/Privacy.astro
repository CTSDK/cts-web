---
import Base from '../../layouts/Base.astro';
import { t, href, type Lang } from '../../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<Base lang={lang} slug="privacy" title={t(lang, 'privacy.title')}>
  <section class="wrap page">
    <h1>{t(lang, 'privacy.title')}</h1>
    <p>{t(lang, 'privacy.text1')}</p>
    <p>{t(lang, 'privacy.text2')}</p>
    <p>{t(lang, 'privacy.text3')}</p>
    <p><a href={href(lang)}>← {t(lang, 'back')}</a></p>
  </section>
</Base>
<style>
  .page { max-width: 42rem; padding-top: 3rem; }
</style>
