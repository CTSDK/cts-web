---
// Egne illustrationer i plakatstil (CTS-farver). Pladsholdere indtil Thomas' fotos kommer.
// Ingen LEGO-logoer eller -figurer: kun almindelige klodser.
interface Props { name: 'bricks' | 'lamp' | 'city'; }
const { name } = Astro.props;

type B = { x: number; y: number; n: number; c: string };
const S = 40; // én knop-bredde
const bricks: B[] = [
  { x: 40, y: 236, n: 4, c: '#b5352a' },
  { x: 200, y: 236, n: 3, c: '#2c5a8a' },
  { x: 320, y: 236, n: 2, c: '#dfa42a' },
  { x: 80, y: 196, n: 2, c: '#dfa42a' },
  { x: 160, y: 196, n: 4, c: '#efe4cc' },
  { x: 320, y: 196, n: 1, c: '#c2571a' },
  { x: 120, y: 156, n: 3, c: '#2c5a8a' },
  { x: 240, y: 156, n: 2, c: '#b5352a' },
  { x: 160, y: 116, n: 2, c: '#c2571a' },
  { x: 200, y: 76, n: 1, c: '#dfa42a' },
];
const ink = '#17140f';
---
{name === 'bricks' && (
  <svg class="illus" viewBox="0 0 400 300" aria-hidden="true">
    <ellipse cx="200" cy="284" rx="180" ry="10" fill="rgba(0,0,0,0.25)" />
    {bricks.map((b) => (
      <g stroke={ink} stroke-width="3" stroke-linejoin="round">
        {Array.from({ length: b.n }, (_, i) => (
          <rect x={b.x + i * S + 8} y={b.y - 11} width="24" height="12" rx="2" fill={b.c} />
        ))}
        <rect x={b.x} y={b.y} width={b.n * S} height="40" rx="2" fill={b.c} />
        <rect x={b.x + 5} y={b.y + 5} width={b.n * S - 10} height="6" fill="rgba(255,255,255,0.28)" stroke="none" />
      </g>
    ))}
    {/* lille klods, der "falder" ned – liv i billedet */}
    <g transform="rotate(-18 330 70)" stroke={ink} stroke-width="3">
      <rect x="318" y="49" width="24" height="12" rx="2" fill="#efe4cc" />
      <rect x="310" y="60" width="40" height="40" rx="2" fill="#efe4cc" />
    </g>
    <path d="M300 40 l-14 -10 M296 58 l-18 0 M304 24 l-6 -14" stroke={ink} stroke-width="3" stroke-linecap="round" />
  </svg>
)}

{name === 'lamp' && (
  <svg class="illus" viewBox="0 0 400 300" aria-hidden="true">
    <polygon points="160,104 240,104 330,262 70,262" fill="rgba(223,164,42,0.28)" />
    <line x1="200" y1="0" x2="200" y2="44" stroke={ink} stroke-width="3" />
    <path d="M130 104 Q 132 46 200 44 Q 268 46 270 104 Z" fill="#c2571a" stroke={ink} stroke-width="3" />
    <path d="M150 92 Q 156 62 196 58" stroke="rgba(255,255,255,0.45)" stroke-width="6" fill="none" stroke-linecap="round" />
    <rect x="124" y="102" width="152" height="8" rx="4" fill="#dfa42a" stroke={ink} stroke-width="3" />
    <ellipse cx="200" cy="114" rx="22" ry="7" fill="#fff6d8" />
    {/* skænk i teak */}
    <rect x="60" y="214" width="280" height="56" rx="3" fill="#8a5a32" stroke={ink} stroke-width="3" />
    <line x1="153" y1="214" x2="153" y2="270" stroke={ink} stroke-width="3" />
    <line x1="246" y1="214" x2="246" y2="270" stroke={ink} stroke-width="3" />
    <circle cx="140" cy="242" r="3" fill={ink} /><circle cx="166" cy="242" r="3" fill={ink} /><circle cx="259" cy="242" r="3" fill={ink} />
    <path d="M80 270 l-8 22 M320 270 l8 22" stroke={ink} stroke-width="4" stroke-linecap="round" />
    {/* vase og bog på skænken */}
    <path d="M100 214 q-10 -26 4 -40 l12 0 q14 14 4 40 Z" fill="#2c5a8a" stroke={ink} stroke-width="3" />
    <rect x="270" y="196" width="46" height="18" fill="#b5352a" stroke={ink} stroke-width="3" />
    <rect x="276" y="182" width="36" height="14" fill="#efe4cc" stroke={ink} stroke-width="3" />
  </svg>
)}

{name === 'city' && (
  <svg class="illus" viewBox="0 0 400 300" aria-hidden="true">
    <circle cx="282" cy="118" r="62" fill="#c2571a" />
    <circle cx="282" cy="118" r="62" fill="none" stroke="#dfa42a" stroke-width="3" stroke-dasharray="2 10" />
    <g fill="#142030" stroke="#efe4cc" stroke-width="2.5" stroke-linejoin="round">
      <path d="M20 230 L20 170 L60 150 L100 170 L100 230 Z" />
      <path d="M110 230 L110 140 L126 140 L126 110 L134 50 L142 110 L142 140 L158 140 L158 230 Z" />
      <path d="M168 230 L168 176 L230 176 L230 230 Z" />
      <path d="M186 176 L186 150 Q 199 126 212 150 L212 176" fill="#4f8a7a" />
      <path d="M240 230 L240 160 L262 160 L262 128 L270 92 L278 128 L278 160 L300 160 L300 230 Z" fill="#4f8a7a" />
      <path d="M310 230 L310 186 L380 186 L380 230 Z" />
    </g>
    <rect x="0" y="230" width="400" height="70" fill="#2c5a8a" />
    <path d="M10 252 q20 -10 40 0 t40 0 t40 0 M170 268 q20 -10 40 0 t40 0 t40 0 M60 286 q20 -10 40 0 t40 0" stroke="#efe4cc" stroke-width="3" fill="none" stroke-linecap="round" />
  </svg>
)}

<style>
  .illus { display: block; width: 100%; height: auto; }
</style>
