---
import { t, href, languages, type Lang, asset } from '../i18n/ui';
interface Props { lang: Lang; slug: string; }
const { lang, slug } = Astro.props;
const nav = [
  { slug: '', key: 'nav.home' },
  { slug: 'lego', key: 'nav.lego' },
  { slug: 'retro', key: 'nav.retro' },
  { slug: 'services', key: 'nav.services' },
] as const;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={href(lang)}>
      <span class="disc"><img src={asset('logo-segl.png')} alt="" width="52" height="52" /></span>
      <span class="word">
        <span class="cts">CTS</span>
        <span class="full">Copenhagen Treasures &amp; Services</span>
      </span>
    </a>
    <nav class="menu" aria-label="Main">
      {nav.map((n) => (
        <a href={href(lang, n.slug)} aria-current={n.slug === slug ? 'page' : undefined}>{t(lang, n.key)}</a>
      ))}
    </nav>
    <nav class="langs" aria-label="Language">
      {Object.entries(languages).map(([code, name]) => (
        <a href={href(code as Lang, slug)} lang={code} aria-current={code === lang ? 'true' : undefined} title={name}>
          {code.toUpperCase()}
        </a>
      ))}
    </nav>
  </div>
  <div class="stripes" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
</header>

<style>
  .site-header { background: var(--navy); color: var(--paper); }
  .bar { display: flex; align-items: center; gap: 12px 28px; padding-top: 12px; padding-bottom: 12px; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--paper); margin-right: auto; }
  .disc { width: 52px; height: 52px; border-radius: 50%; background: var(--paper); flex: none; overflow: hidden; }
  .disc img { width: 52px; height: 52px; }
  .word { display: flex; flex-direction: column; line-height: 1; }
  .cts { font-family: var(--font-display); font-size: 2rem; color: var(--mustard); letter-spacing: 0.04em; }
  .full { font-family: var(--font-label); font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase; margin-top: 4px; }
  .menu { display: flex; flex-wrap: wrap; gap: 4px 26px; }
  .menu a { font-family: var(--font-label); text-transform: uppercase; letter-spacing: 0.08em; font-size: 1rem; text-decoration: none; color: var(--paper); padding: 4px 0; border-bottom: 2px solid transparent; }
  .menu a:hover { color: var(--mustard); }
  .menu a[aria-current] { border-bottom-color: var(--orange); }
  .langs { display: flex; gap: 6px; }
  .langs a { font-family: var(--font-label); letter-spacing: 0.1em; text-decoration: none; color: var(--paper); border: 1.5px solid var(--paper); padding: 4px 10px; font-size: 0.9rem; }
  .langs a[aria-current] { background: var(--orange); border-color: var(--orange); color: var(--paper); }
  .stripes { display: grid; grid-template-columns: 3fr 1fr 1fr 1fr; height: 6px; }
  .stripes span:nth-child(1) { background: var(--navy-deep); }
  .stripes span:nth-child(2) { background: var(--mustard); }
  .stripes span:nth-child(3) { background: var(--red); }
  .stripes span:nth-child(4) { background: var(--orange); }
  @media (max-width: 760px) {
    .menu { order: 3; width: 100%; gap: 2px 18px; border-top: 1px solid rgba(239, 228, 204, 0.25); padding-top: 8px; }
    .menu a { font-size: 0.92rem; }
    .full { display: none; }
  }
</style>
