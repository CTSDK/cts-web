---
import { t, href, languages, type Lang, asset } from '../i18n/ui';
interface Props { lang: Lang; slug: string; }
const { lang, slug } = Astro.props;
const nav = [
  { slug: '', key: 'nav.home' },
  { slug: 'lego', key: 'nav.lego' },
  { slug: 'retro', key: 'nav.retro' },
  { slug: 'services', key: 'nav.services' },
] as const;
---
<header class="site-header">
  <div class="wrap top">
    <a class="brand" href={href(lang)}>
      <img src={asset('logo-segl.png')} alt="CTS – Copenhagen Treasures & Services, Denmark" width="56" height="56" />
      <span>Copenhagen Treasures <span class="amp">&amp;</span> Services</span>
    </a>
    <nav class="langs" aria-label="Language">
      {Object.entries(languages).map(([code, name]) => (
        <a href={href(code as Lang, slug)} lang={code} aria-current={code === lang ? 'true' : undefined} title={name}>
          {code.toUpperCase()}
        </a>
      ))}
    </nav>
  </div>
  <hr class="double-rule" />
  <nav class="wrap menu" aria-label="Main">
    {nav.map((n) => (
      <a href={href(lang, n.slug)} aria-current={n.slug === slug ? 'page' : undefined}>{t(lang, n.key)}</a>
    ))}
  </nav>
  <hr class="double-rule" />
</header>

<style>
  .site-header { padding-top: 12px; }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-bottom: 10px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--ink); font-family: var(--font-display); font-size: 1.3rem; line-height: 1.1; }
  .brand img { width: 56px; height: 56px; flex: none; }
  .amp { color: var(--accent); }
  .langs { display: flex; gap: 4px; }
  .langs a { font-family: var(--font-display); text-decoration: none; color: var(--ink-soft); border: 1px solid transparent; padding: 2px 8px; }
  .langs a[aria-current] { color: var(--paper); background: var(--ink); }
  .menu { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 28px; padding-top: 8px; padding-bottom: 8px; }
  .menu a { font-family: var(--font-display); font-size: 1.15rem; text-decoration: none; color: var(--ink); }
  .menu a:hover, .menu a[aria-current] { color: var(--accent); }
  .menu a[aria-current] { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }
  @media (max-width: 560px) {
    .brand span { font-size: 1.05rem; }
    .brand img { width: 44px; height: 44px; }
    .menu { gap: 2px 18px; }
    .menu a { font-size: 1.05rem; }
  }
</style>
