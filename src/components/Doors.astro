---
// De tre afdelinger som runde billedvinduer (farveflade nu, foto senere)
// med rund "+"-knap som på LEGO-siden. Under: Stone Groove-typografi.
import Icon from './Icon.astro';
import { t, href, asset, type Lang } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const doors = [
  { no: '01', slug: 'lego', icon: 'brick', color: 'var(--mustard)', photo: 'img/lego/themes/castle.jpg', title: 'door.lego.title', text: 'door.lego.text', soon: false },
  { no: '02', slug: 'retro', icon: 'lamp', color: 'var(--orange)', photo: 'img/retro/lamp.jpg', title: 'door.retro.title', text: 'door.retro.text', soon: false },
  { no: '03', slug: 'services', icon: 'city', color: 'var(--navy)', title: 'door.services.title', text: 'door.services.text', soon: true },
] as const;
---
<ul class="doors">
  <!-- Midten af rombeformen: velkomst-teksten (sendes ind fra forsiden) -->
  <li class="d-center"><slot /></li>
  {doors.map((d) => (
    <li class={`d-${d.slug}`}>
      <a class="door" href={href(lang, d.slug)} style={`--c: ${d.color}`}>
        <span class="window">
          {'photo' in d && d.photo ? <img class="photo" src={asset(d.photo)} alt="" width="480" height="480" /> : <Icon name={d.icon} />}
          <span class="plus" aria-hidden="true">+</span>
        </span>
        <span class="body">
          <span class="no">No. {d.no}</span>
          <h3>{t(lang, d.title)}</h3>
          {d.text && <p>{t(lang, d.text)}</p>}
          <span class="btn">{d.soon ? t(lang, 'soon') : t(lang, 'door.enter')} →</span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  /* Rombe: seglet øverst, LEGO og Retro i siderne med velkomst-teksten i midten, Services nederst.
     Afstandene måles, så de er ens hele vejen rundt. */
  .doors {
    list-style: none; padding: 0; margin: var(--doors-top, 0) auto 0; max-width: 1060px;
    display: grid; grid-template-columns: 320px 1fr 320px; grid-template-rows: 260px auto; row-gap: 0;
    /* Række 1 er låst til cirklernes højde, så tekstlængden ikke flytter Services */
  }
  .d-lego { grid-column: 1; grid-row: 1; }
  .d-center { grid-column: 2; grid-row: 1; height: 260px; display: flex; flex-direction: column; justify-content: center; align-items: center; }
  .d-retro { grid-column: 3; grid-row: 1; }
  .d-services { grid-column: 1 / -1; grid-row: 2; justify-self: center; width: 460px; margin-top: var(--diamond-pull, 110px); }
  @media (max-width: 1100px) {
    .doors { max-width: 820px; grid-template-columns: 1fr 1fr; grid-template-rows: none; gap: 48px 40px; }
    .d-center { grid-column: 1 / -1; grid-row: 1; height: auto; }
    .d-lego { grid-column: 1; grid-row: 2; }
    .d-retro { grid-column: 2; grid-row: 2; }
    .d-services { grid-row: 3; width: calc(50% - 20px); margin-top: 0; }
  }
  @media (max-width: 640px) {
    .doors { grid-template-columns: 1fr; }
    .d-center, .d-lego, .d-retro, .d-services { grid-column: 1; grid-row: auto; width: auto; justify-self: stretch; }
  }
  .door { display: flex; flex-direction: column; align-items: center; height: 100%; text-decoration: none; color: var(--ink); }
  .door:hover { color: var(--ink); }

  /* Rundt billedvindue (farveflade nu, foto senere) med rund "+"-knap */
  .window {
    position: relative; display: flex; align-items: center; justify-content: center;
    width: min(260px, 82%); aspect-ratio: 1; border-radius: 50%; background: var(--c);
    box-shadow: 0 0 0 6px var(--paper), 0 0 0 7px var(--ink);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .door:hover .window { transform: translateY(-4px); box-shadow: 0 0 0 6px var(--paper), 0 0 0 7px var(--ink), 0 16px 30px rgba(28, 43, 61, 0.18); }
  .photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
  .window :global(.icon) { width: 44%; height: auto; color: var(--paper); }
  .plus {
    position: absolute; right: 8%; bottom: 8%; width: 36px; height: 36px; border-radius: 50%;
    background: #fff; color: var(--ink); box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
    display: flex; align-items: center; justify-content: center; font-family: var(--font-label); font-size: 1.35rem; line-height: 1;
  }
  .door:hover .plus { background: var(--ink); color: #fff; }

  .body { display: flex; flex-direction: column; align-items: center; text-align: center; flex: 1; padding: 24px 10px 0; }
  .no { font-family: var(--font-label); text-transform: uppercase; letter-spacing: 0.3em; font-size: 0.9rem; color: var(--orange); }
  h3 { margin: 0.4rem 0 0.6rem; font-size: 2.6rem; }
  p { margin: 0 0 1.4rem; color: var(--ink); font-size: 1.68rem; line-height: 1.4; max-width: 26rem; }
  .btn { margin-top: auto; font-size: 1.05rem; }
  .door:hover .btn { background: var(--ink); color: var(--paper); }
</style>
