---
// De tre buede døre. Toppen er et "billedvindue" (farveflade nu, foto senere)
// med rund "+"-knap som på LEGO-siden. Under: Stone Groove-typografi.
import Icon from './Icon.astro';
import { t, href, type Lang } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const doors = [
  { no: '01', slug: 'lego', icon: 'brick', color: 'var(--mustard)', title: 'door.lego.title', text: 'door.lego.text', soon: false },
  { no: '02', slug: 'retro', icon: 'lamp', color: 'var(--orange)', title: 'door.retro.title', text: 'door.retro.text', soon: false },
  { no: '03', slug: 'services', icon: 'city', color: 'var(--navy)', title: 'door.services.title', text: 'door.services.text', soon: true },
] as const;
---
<ul class="doors">
  {doors.map((d) => (
    <li>
      <a class="door" href={href(lang, d.slug)} style={`--c: ${d.color}`}>
        <span class="window">
          <Icon name={d.icon} />
          <span class="plus" aria-hidden="true">+</span>
        </span>
        <span class="body">
          <span class="no">No. {d.no}</span>
          <h3>{t(lang, d.title)}</h3>
          <p>{t(lang, d.text)}</p>
          <span class="btn">{d.soon ? t(lang, 'soon') : t(lang, 'door.enter')} →</span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .doors { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 28px; }
  .door {
    display: flex; flex-direction: column; height: 100%; text-decoration: none; color: var(--ink);
    background: #fff; border: 1px solid var(--ink); border-radius: 160px 160px 0 0; overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .door:hover { transform: translateY(-4px); box-shadow: 0 14px 30px rgba(28, 43, 61, 0.14); color: var(--ink); }

  /* Billedvindue i den buede top */
  .window {
    position: relative; display: flex; align-items: center; justify-content: center;
    aspect-ratio: 5 / 4; background: var(--c);
  }
  .window :global(.icon) { width: 38%; height: auto; color: var(--paper); }
  .plus {
    position: absolute; left: 16px; bottom: 16px; width: 34px; height: 34px; border-radius: 50%;
    background: #fff; color: var(--ink); box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
    display: flex; align-items: center; justify-content: center; font-family: var(--font-label); font-size: 1.35rem; line-height: 1;
  }
  .door:hover .plus { background: var(--ink); color: #fff; }

  .body { display: flex; flex-direction: column; align-items: center; text-align: center; flex: 1; padding: 22px 22px 26px; border-top: 1px solid var(--ink); }
  .no { font-family: var(--font-label); text-transform: uppercase; letter-spacing: 0.3em; font-size: 0.75rem; color: var(--orange); }
  h3 { margin: 0.4rem 0 0.5rem; font-size: 2rem; }
  p { margin: 0 0 1.3rem; color: var(--ink-soft); font-size: 0.95rem; }
  .btn { margin-top: auto; }
  .door:hover .btn { background: var(--ink); color: var(--paper); }
</style>
