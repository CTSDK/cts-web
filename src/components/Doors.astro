---
// De tre afdelinger som artikler i magasinet. Billedfeltet er klar til rigtige fotos senere.
// LEGO har et (dæmpet) katalog-præg: knop-mønster og rundt mærke – ingen LEGO-logoer.
import Icon from './Icon.astro';
import { t, href, type Lang } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const doors = [
  { no: '01', slug: 'lego', icon: 'brick', kind: 'lego', badge: 'badge.lego', title: 'door.lego.title', text: 'door.lego.text', soon: false },
  { no: '02', slug: 'retro', icon: 'lamp', kind: 'retro', badge: 'badge.retro', title: 'door.retro.title', text: 'door.retro.text', soon: false },
  { no: '03', slug: 'services', icon: 'city', kind: 'services', badge: 'badge.services', title: 'door.services.title', text: 'door.services.text', soon: true },
] as const;
---
<ul class="articles">
  {doors.map((d) => (
    <li>
      <a class={`article ${d.kind}`} href={href(lang, d.slug)}>
        <span class="pic">
          <Icon name={d.icon} />
          <span class="badge">{t(lang, d.badge)}</span>
        </span>
        <span class="kicker">No. {d.no}</span>
        <h3>{t(lang, d.title)}</h3>
        <p>{t(lang, d.text)}</p>
        <span class="btn">{d.soon ? t(lang, 'soon') : t(lang, 'door.enter')} →</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .articles { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 32px; }
  .article { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: var(--ink); }
  .article:hover { color: var(--ink); }

  /* Billedfelt */
  .pic {
    position: relative; display: flex; align-items: center; justify-content: center;
    aspect-ratio: 4 / 3; overflow: hidden; border: 1.5px solid var(--ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .article:hover .pic { transform: translate(-3px, -3px); box-shadow: 6px 6px 0 var(--ink); }
  .pic :global(.icon) { width: 46%; height: auto; }

  /* LEGO: dæmpet katalog – sennep med knop-mønster */
  .lego .pic {
    background-color: var(--mustard);
    background-image: radial-gradient(circle at center, rgba(255, 255, 255, 0.22) 0 7px, rgba(0, 0, 0, 0.10) 7px 9px, transparent 9px);
    background-size: 34px 34px;
  }
  .lego .pic :global(.icon) { color: var(--ink); }
  /* Retro: papir med orange striber som et magasinopslag */
  .retro .pic {
    background: linear-gradient(90deg, var(--paper-deep) 0 70%, var(--orange) 70% 80%, var(--red) 80% 90%, var(--mustard) 90%);
  }
  .retro .pic :global(.icon) { color: var(--ink); margin-right: 22%; }
  /* Services: marineblå */
  .services .pic { background: var(--navy); }
  .services .pic :global(.icon) { color: var(--paper); }

  /* Rundt mærke som i katalogerne */
  .badge {
    position: absolute; top: 14px; left: 14px; width: 92px; height: 92px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; text-align: center; padding: 10px;
    font-family: var(--font-label); font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.72rem; line-height: 1.15;
    transform: rotate(-12deg); color: var(--paper); background: var(--red);
    box-shadow: 0 0 0 3px var(--paper), 0 0 0 4.5px var(--red);
  }
  .retro .badge { background: var(--navy); box-shadow: 0 0 0 3px var(--paper), 0 0 0 4.5px var(--navy); }
  .services .badge { background: var(--orange); box-shadow: 0 0 0 3px var(--navy), 0 0 0 4.5px var(--orange); }

  .kicker {
    margin-top: 1.1rem; padding-bottom: 6px; border-bottom: 1.5px solid var(--ink);
    font-family: var(--font-label); text-transform: uppercase; letter-spacing: 0.3em; font-size: 0.8rem; color: var(--orange);
  }
  h3 { margin: 0.7rem 0 0.4rem; font-size: 2.2rem; }
  p { margin: 0 0 1.2rem; color: var(--ink-soft); }
  .btn { margin-top: auto; align-self: flex-start; }
  .article:hover .btn { background: var(--ink); color: var(--paper); }
</style>
