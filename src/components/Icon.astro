---
// Enkle stregtegninger i samme stil som træet i seglet.
interface Props { name: 'brick' | 'lamp' | 'city'; }
const { name } = Astro.props;
---
<svg class="icon" viewBox="0 0 120 90" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
  {name === 'brick' && (
    <g>
      <rect x="18" y="38" width="84" height="36" rx="2" />
      <rect x="26" y="26" width="16" height="12" rx="2" />
      <rect x="52" y="26" width="16" height="12" rx="2" />
      <rect x="78" y="26" width="16" height="12" rx="2" />
    </g>
  )}
  {name === 'lamp' && (
    <g>
      <path d="M38 40 L60 12 L82 40 Z" />
      <path d="M60 40 L60 72" />
      <path d="M44 76 L76 76" />
      <path d="M60 40 Q 66 50 60 56" stroke-width="2" />
    </g>
  )}
  {name === 'city' && (
    <g>
      <path d="M10 76 L110 76" />
      <path d="M18 76 L18 50 L30 42 L42 50 L42 76" />
      <path d="M50 76 L50 44 L58 44 L58 30 L62 14 L66 30 L66 44 L74 44 L74 76" />
      <path d="M82 76 L82 54 L96 54 L96 76" />
      <path d="M89 54 L89 40" />
      <circle cx="89" cy="37" r="3" />
    </g>
  )}
</svg>
<style>
  .icon { width: 120px; height: 90px; color: var(--ink); }
</style>
